# =============================================================================
# Required
# -----------------------------------------------------------------------------
# The service will not run correctly without these. Copy this file to .env and
# fill in each value. DATAFORSEO_USERNAME / DATAFORSEO_PASSWORD are hard-required
# (the process panics on startup if either is unset); the rest are required for
# their respective features to work.
# =============================================================================

# DataForSEO (keyword / SERP data). Startup panics if either is missing.
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Shared secret authenticating requests between the API and the publisher sidecar.
SIDECAR_SHARED_SECRET=

# MongoDB connection string (e.g. mongodb://localhost:27017 or an Atlas SRV URI).
MONGO_URI=

# Clerk (must be the same Clerk app as the frontend). The webhook secret is the
# signing secret for the Clerk webhook endpoint.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# LLM providers. ANTHROPIC_API_KEY powers text generation (outline, article,
# image prompt + alt text); GEMINI_API_KEY also powers image generation
# (gemini-2.5-flash-image). OPENAI_API_KEY is the default provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AWS credentials + S3 bucket for asset uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Paddle Billing (API key, webhook secret, and product ID). The webhook secret
# is per notification destination ("pdl_ntfset_..."). Sandbox vs. live is
# derived from ENVIRONMENT in code, not set here: only ENVIRONMENT=production
# uses live Paddle.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=
# Per-seat "Indexly Team" product. Empty = team billing dark (company checkout 400s).
PADDLE_TEAM_PRODUCT_ID=

# SQS queue URLs: primary work queue, secondary (clustering) queue, and DLQ.
SQS_QUEUE_URL=
SQS_SECONDARY_QUEUE_URL=
SQS_DLQ_URL=

# Tavily web search API key.
TAVILY_API_KEY=

# Google Search Console analytics: service-account key JSON, base64-encoded
# (users add the SA's client_email to their GSC property; scope is
# webmasters.readonly). Empty disables the GSC provider — the analytics
# surface is also values-flagged (gsc.enabled).
GSC_SERVICE_ACCOUNT_JSON=

# Google PageSpeed Insights API key (audit engine Performance category —
# CrUX field data). Free, key-only. Empty = the PSI collector degrades to a
# constraint per audit; boot proceeds.
GOOGLE_PSI_API_KEY=

# YouTube Data API key + Webshare proxy credentials (transcript fetching).
YOUTUBE_API_KEY=
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# =============================================================================
# Optional overrides
# -----------------------------------------------------------------------------
# Leave blank to use the built-in defaults / per-environment values.yaml. Set a
# value only to override. Numeric overrides fall back to values.yaml when unset
# or 0.
# =============================================================================

# HTTP server port (defaults to values.yaml Server.Port).
PORT=

# Deployment environment: development, integration, or production
# (defaults to the built-in default environment).
ENVIRONMENT=

# MongoDB database name (defaults to values.yaml Server.DefaultDBName).
MONGO_DB_NAME=

# AWS region (defaults to values.yaml Server.AWSRegion).
AWS_REGION=

# Default LLM provider (defaults to values.yaml LLM.DefaultProvider).
LLM_DEFAULT_PROVIDER=


# Host allowlist, comma-separated. Overrides values.yaml Server.AllowedHosts.
# Empty leaves the server unrestricted.
ALLOWED_HOSTS=

# CORS allowed origins, comma-separated.
CORS_ALLOWED_ORIGINS=

# Explicit path to a values.yaml file. Overrides the ENVIRONMENT-based lookup.
VALUES_FILE=

# SQS tunables (seconds). Fall back to values.yaml when unset or 0.
SQS_WAIT_TIME_SECONDS=
SQS_VISIBILITY_TIMEOUT=
SQS_CLUSTERING_VISIBILITY_TIMEOUT=

# Async worker pool tunables. Fall back to values.yaml when unset or 0.
ASYNC_WORKER_COUNT=
ASYNC_LLM_WORKER_COUNT=
ASYNC_MAX_RETRIES=
ASYNC_SHUTDOWN_TIMEOUT_SECONDS=
ASYNC_TOKEN_LIMIT=
ASYNC_TOKEN_WINDOW_SECONDS=

# Company tenancy: frontend invite-link template ({token} substituted).
# Overrides the per-env values.yaml default; empty keeps the YAML value.
COMPANY_INVITE_URL_TEMPLATE=

# SMTP mailer for company invite emails. Empty SMTP_HOST disables sending —
# the invite flow surfaces the link in the API response instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# cmd/planscheck (throwaway read-only entitlements probe) only: user email to
# dump entitlement projections for. Unused by the service.
CHECK_EMAIL=
