# =============================================================================
# Required
# -----------------------------------------------------------------------------
# The service will not run correctly without these. Copy this file to .env and
# fill in each value. CLERK_SECRET_KEY is hard-required (startup fails without
# it); the rest are required for their respective features to work.
# =============================================================================

# MongoDB connection string (e.g. mongodb://localhost:27017 or an Atlas SRV URI).
MONGO_URI=

# Clerk (must be the same Clerk app as the frontend). The webhook secret is the
# signing secret for the Clerk webhook endpoint.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Claude (the only LLM; AI search, D-080).
ANTHROPIC_API_KEY=
# AI search LLM: "anthropic" (default) or "groq". Groq uses GROQ_API_KEY,
# AISEARCH_GROQ_MODEL (default openai/gpt-oss-120b) and AISEARCH_GROQ_MODE
# ("json", the default, or "tool" for a native forced function call).
# AISEARCH_TIMEOUT_MS overrides the extraction deadline (values default 2200).
AISEARCH_PROVIDER=
GROQ_API_KEY=
AISEARCH_GROQ_MODEL=
AISEARCH_GROQ_MODE=
AISEARCH_TIMEOUT_MS=
# Per-user AI search limit (signed-in visitors; staff exempt), in memory per
# instance: requests per minute (default 10) and per 24 hours (default 100).
AISEARCH_USER_PER_MIN=
AISEARCH_USER_PER_DAY=

# Google Maps Platform key for geocoding (draft addresses, search places).
# Empty = no geocoding; editors drop the pin by hand.
GOOGLE_MAPS_API_KEY=
# Voyage AI embeddings (AI search similar matches). Empty = no semantic fallback.
VOYAGE_API_KEY=

# AWS credentials + the two media buckets (D-015): public media behind
# CloudFront (PUBLIC_MEDIA_BASE_URL is the CloudFront origin, e.g.
# https://media.example.com) and private staff docs (presigned GET only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BUCKET=
AWS_S3_PRIVATE_BUCKET=
PUBLIC_MEDIA_BASE_URL=

# SQS queue URLs: work queue and DLQ.
SQS_QUEUE_URL=
SQS_DLQ_URL=

# =============================================================================
# Optional overrides
# -----------------------------------------------------------------------------
# Leave blank to use the built-in defaults / per-environment values.yaml. Set a
# value only to override. Numeric overrides fall back to values.yaml when unset
# or 0.
# =============================================================================

# HTTP server port (defaults to values.yaml Server.Port).
PORT=

# Deployment environment: development, integration, or production
# (defaults to the built-in default environment).
ENVIRONMENT=

# MongoDB database name (defaults to values.yaml Server.DefaultDBName).
MONGO_DB_NAME=

# AWS region (defaults to values.yaml Server.AWSRegion).
AWS_REGION=

# Host allowlist, comma-separated. Overrides values.yaml Server.AllowedHosts.
# Empty leaves the server unrestricted.
ALLOWED_HOSTS=

# CORS allowed origins, comma-separated. The WarehouseHub frontend calls the
# API server-side through its /api/proxy route, so it needs no entry here.
CORS_ALLOWED_ORIGINS=

# HTTP server timeouts: a Go duration ("45s", "2m") or whole seconds.
# Defaults: read header 10s, read 30s, write 60s, idle 120s. Bulk approve
# extends its own write deadline to 5 minutes.
HTTP_READ_HEADER_TIMEOUT=
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=
HTTP_IDLE_TIMEOUT=

# Warehouse Finder per-IP rate limit (in memory, per instance), shared by
# /v1/public/finder/*: sustained requests per minute (default 60) and burst
# (default 20). FINDER_TRUST_PROXY=true takes the client IP from
# CF-Connecting-IP / X-Forwarded-For: set it only behind a proxy that sets
# those headers (e.g. a Cloudflare tunnel), or clients can spoof them.
FINDER_RATE_PER_MIN=
FINDER_RATE_BURST=
FINDER_TRUST_PROXY=

# WarehouseHub frontend origin (e.g. https://warehousehub.in). Overrides
# values.yaml warehousehub.publicBaseURL / adminBaseURL: listing links in the
# enquiry inbox and the listing JSON-LD url. The admin panel lives at
# <origin>/admin in the same app.
PUBLIC_BASE_URL=
ADMIN_BASE_URL=

# Explicit path to a values.yaml file. Overrides the ENVIRONMENT-based lookup.
VALUES_FILE=

# SQS tunables (seconds). Fall back to values.yaml when unset or 0.
SQS_WAIT_TIME_SECONDS=
SQS_VISIBILITY_TIMEOUT=

# Async worker pool tunables. Fall back to values.yaml when unset or 0.
ASYNC_WORKER_COUNT=
ASYNC_MAX_RETRIES=
ASYNC_SHUTDOWN_TIMEOUT_SECONDS=

